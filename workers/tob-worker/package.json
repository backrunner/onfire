{
  "name": "@onfire/tob-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 0",
    "dev:worker": "wrangler dev --port 8788 --inspector-port 0",
    "build:web": "cd ../../apps/tob-web && bun run build",
    "build": "bun run build:web && wrangler deploy --dry-run --outdir dist",
    "deploy": "bun run build:web && wrangler deploy",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.56",
    "@ai-sdk/google": "^2.0.46",
    "@ai-sdk/openai": "^2.0.85",
    "@onfire/shared": "workspace:*",
    "ai": "^6.0.0-beta.148",
    "better-auth": "^1.4.5",
    "drizzle-orm": "^0.45.0",
    "elysia": "^1.4.18",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.53.0"
  }
}
