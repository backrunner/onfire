{
  "name": "@onfire/tob-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 0",
    "dev:worker": "wrangler dev --port 8788 --inspector-port 0",
    "build:web": "cd ../../apps/tob-web && pnpm run build",
    "build": "pnpm run build:web && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm run build:web && wrangler deploy",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@onfire/shared": "workspace:*"
  }
}
