# Copy to .dev.vars. This file is read by Wrangler/OpenNext, not by Next.js.
# Generate your own AUTH_SECRET with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3001
ADMIN_DOMAINS=localhost,admin.localhost
TOC_DOMAINS=localhost

# Local CAPTCHA is off by default. To test it, uncomment this official test
# secret AND the matching public test site key in .env.local.
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
