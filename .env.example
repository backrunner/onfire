# Copy to .env.local for Next.js local development.
# Keep the canonical origin in sync with .dev.vars.
BETTER_AUTH_URL=http://localhost:3001
ADMIN_DOMAINS=localhost,admin.localhost
TOC_DOMAINS=localhost

# Turnstile: enable only together with TURNSTILE_SECRET in .dev.vars.
# This is Cloudflare's public, always-passing development test key.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
