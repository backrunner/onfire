{
  "packageManager": "pnpm@12.3.4",
  "name": "onfire",
  "version": "0.2.0",
  "private": true,
  "description": "A modern multi-tenant ticket system for Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "https://github.com/backrunner/onfire.git"
  },
  "bugs": {
    "url": "https://github.com/backrunner/onfire/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -n toc,tob -c blue,green \"next dev --turbopack -p 3000\" \"NEXT_DIST_DIR=.next-tob next dev --turbopack -p 3001\"",
    "dev:toc": "next dev --turbopack -p 3000",
    "dev:tob": "NEXT_DIST_DIR=.next-tob next dev --turbopack -p 3001",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && pnpm build:email-agent",
    "cf-typegen": "node scripts/cf-typegen.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm build:worker && wrangler dev",
    "deploy": "pnpm build:worker && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset": "node --experimental-strip-types --no-warnings scripts/local-dev.ts reset",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/local-dev.ts seed",
    "db:seed:tickets": "node --experimental-strip-types --no-warnings scripts/local-dev.ts tickets",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:email-agent": "wrangler deploy --dry-run -c workers/email-agent/wrangler.jsonc --outdir .wrangler/email-agent",
    "deploy:email-agent": "wrangler deploy -c workers/email-agent/wrangler.jsonc"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@marsidev/react-turnstile": "^1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "postal-mime": "^4.1.4",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
