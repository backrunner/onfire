{
  "name": "onfire",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:tob": "cd apps/tob && pnpm dev",
    "dev:toc": "cd apps/toc && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "init": "bash scripts/init.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c apps/tob/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c apps/tob/wrangler.toml",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy:tob": "cd apps/tob && pnpm run deploy",
    "deploy:toc": "cd apps/toc && pnpm run deploy",
    "deploy:all": "pnpm run deploy:tob && pnpm run deploy:toc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.14",
    "@ai-sdk/google": "^3.0.9",
    "@ai-sdk/openai": "^3.0.11",
    "@hono/zod-validator": "^0.7.6",
    "ai": "^6.0.37",
    "better-auth": "^1.4.13",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.4",
    "nanoid": "^5.1.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260115.0",
    "@types/node": "^22.19.6",
    "drizzle-kit": "^0.31.8",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
