{
  "packageManager": "pnpm@12.3.4",
  "name": "onfire",
  "version": "0.2.0",
  "private": true,
  "description": "A modern multi-tenant ticket system for Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "https://github.com/backrunner/onfire.git"
  },
  "bugs": {
    "url": "https://github.com/backrunner/onfire/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "BackRunner",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -n toc,tob -c blue,green \"next dev --turbopack -p 3000\" \"NEXT_DIST_DIR=.next-tob next dev --turbopack -p 3001\"",
    "dev:toc": "next dev --turbopack -p 3000",
    "dev:tob": "NEXT_DIST_DIR=.next-tob next dev --turbopack -p 3001",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && pnpm build:email-agent",
    "cf-typegen": "node scripts/cf-typegen.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm build:worker && wrangler dev",
    "deploy": "pnpm build:worker && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset": "node --experimental-strip-types --no-warnings scripts/local-dev.ts reset",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/local-dev.ts seed",
    "db:seed:tickets": "node --experimental-strip-types --no-warnings scripts/local-dev.ts tickets",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:email-agent": "wrangler deploy --dry-run -c workers/email-agent/wrangler.jsonc --outdir .wrangler/email-agent",
    "deploy:email-agent": "wrangler deploy -c workers/email-agent/wrangler.jsonc"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.16",
    "@assistant-ui/react-markdown": "^0.14.12",
    "@better-auth/oauth-provider": "1.7.0-rc.5",
    "@better-auth/passkey": "1.7.0-rc.5",
    "@marsidev/react-turnstile": "^1.5.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "better-auth": "1.7.0-rc.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.4",
    "postal-mime": "^2.7.5",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
