    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.55.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svedocs": "0.2.3",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "svedocs-cli": "0.2.3",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
