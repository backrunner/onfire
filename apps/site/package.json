    "licenses:inventory": "node scripts/dependency-licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.61.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svedocs": "0.3.0",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "svedocs-cli": "0.3.0",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3"
