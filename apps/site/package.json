    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.55.7",
    "svedocs": "0.2.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "svedocs-cli": "0.2.1",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "svelte-check": "^4.7.6"
