# Copy to .env.production.local and replace these example domains before build.
# These MUST match vars in wrangler.jsonc. Middleware is included in the build.
BETTER_AUTH_URL=https://admin.example.com
ADMIN_DOMAINS=admin.example.com
TOC_DOMAINS=support.example.com
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_PORT_ROUTING=false

# Public site key only. Store the matching TURNSTILE_SECRET with Wrangler.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_YOUR_PUBLIC_SITE_KEY
