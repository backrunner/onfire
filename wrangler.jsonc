// Public deployment template. Replace example domains, addresses and resource IDs.
// See docs/DEPLOYMENT.md before deploying.
{
  "name": "onfire",
  "main": "worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "support.example.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.example.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onfire-d1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "onfire-storage"
    },
    { "binding": "EMAIL_STORAGE", "bucket_name": "onfire-email-storage" }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "onfire-knowledge"
    }
  ],
  // Cloudflare Email Service — outbound provider "cloudflare".
  // The sender domain must be onboarded first:
  //   npx wrangler email sending enable yourdomain.com
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  // Cron: SLA breach scan + auto-close, every 5 minutes
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Secrets (AUTH_SECRET, TURNSTILE_SECRET) must be set via
  //   wrangler secret put AUTH_SECRET
  //   wrangler secret put TURNSTILE_SECRET
  // and locally via .dev.vars — never commit them as plaintext vars.
  "vars": {
    "BETTER_AUTH_URL": "https://admin.example.com",
    "JWT_ISSUER": "onfire",
    "JWT_AUDIENCE": "onfire-toc",
    "ADMIN_DOMAINS": "admin.example.com",
    "TOC_DOMAINS": "support.example.com",
    "EMAIL_AGENT_ADDRESSES": "support@example.com",
    "EMAIL_AGENT_PRODUCTS": { "support@example.com": "REPLACE_WITH_PRODUCT_ID" }
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onfire"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "EMAIL_INBOUND_QUEUE", "queue": "onfire-email-inbound" },
      { "binding": "EMAIL_OUTBOUND_QUEUE", "queue": "onfire-email-outbound" }
    ],
    "consumers": [{ "queue": "onfire-email-inbound", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 12, "retry_delay": 60, "max_concurrency": 2, "dead_letter_queue": "onfire-email-inbound-dlq" }]
  },
  "limits": { "cpu_ms": 300000 },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
