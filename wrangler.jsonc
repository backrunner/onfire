{
  "name": "onfire",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onfire-d1",
      "database_id": "your-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "onfire-storage"
    }
  ],
  "vars": {
    "AUTH_SECRET": "",
    "TURNSTILE_SECRET": "",
    "JWT_ISSUER": "onfire",
    "JWT_AUDIENCE": "onfire"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onfire"
    }
  ]
}
